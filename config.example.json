    "anthropic": {
      "_note": "Reached over Anthropic's native Messages API (x-api-key + anthropic-version). llmproxy translates OpenAI \u21c4 Anthropic, so OpenAI clients can call Claude and Anthropic clients (/v1/messages) can call any provider. Models are advertised from model_filter (no OpenAI-shaped /models endpoint).",
      "base_url": "https://api.anthropic.com/v1",
      "api_key": "...",
      "model_filter": [
        "claude-opus-4-8",
        "claude-sonnet-4-6",
        "claude-haiku-4-5",
        "claude-fable-5"
      ],
      "protocol": "anthropic"
    },
    "gemini": {
      "_note": "Reached over Gemini's native generateContent/streamGenerateContent API (x-goog-api-key). llmproxy translates OpenAI \u21c4 Gemini. The OpenAI-compatible 'google' provider above is an alternative; this entry uses Gemini's native protocol. Models are advertised from model_filter.",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "api_key": "...",
      "model_filter": [
        "gemini-2.5-pro",
        "gemini-2.5-flash"
